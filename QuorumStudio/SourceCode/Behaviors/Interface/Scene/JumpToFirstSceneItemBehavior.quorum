package Libraries.Development.Environment.Studio.Behaviors

use Libraries.Development.Environment.Studio.Behaviors.QuorumStudioBehavior
use Libraries.Interface.Events.BehaviorEvent
use Libraries.Development.Environment.Studio.QuorumStudio
use Libraries.Interface.Controls.Scenes.SceneTree
use Libraries.Interface.Controls.Scenes.SceneTreeItem
use Libraries.Interface.Controls.TreeItem
use Libraries.Containers.Iterator

/*
    JumpToFirstSceneItemBehavior moves the selection and focus to the first
    item in the current scene (the first scene object found in the Scene
    Tree, skipping layer and camera entries). This is the first step toward
    a larger feature that will let users cycle between scene items.
*/
class JumpToFirstSceneItemBehavior is QuorumStudioBehavior

    action Run(BehaviorEvent event)
        QuorumStudio studio = GetMainApplication()
        SceneTree tree = studio:GetSceneTree()
        if tree = undefined
            return now
        end

        SceneTreeItem firstItem = FindFirstSceneItem(tree:GetTreeItems())
        if firstItem = undefined
            return now
        end

        firstItem:Select()
        firstItem:Activate()
    end

    /*
        Walks the Scene Tree, in order, looking for the first TreeItem that
        represents an actual scene item (as opposed to a layer or camera
        entry). Returns undefined if the scene has no items.
    */
    private action FindFirstSceneItem(Iterator<TreeItem> items) returns SceneTreeItem
        repeat while items:HasNext()
            SceneTreeItem candidate = cast(SceneTreeItem, items:Next())
            if candidate:GetSceneItem() not= undefined
                return candidate
            end

            SceneTreeItem nested = FindFirstSceneItem(candidate:GetTreeItems())
            if nested not= undefined
                return nested
            end
        end

        return undefined
    end
end
